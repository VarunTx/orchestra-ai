--- /dev/null
+++ b/engine/scripts/check-local-d1.mjs
@@ -0,0 +1,21 @@
+// Local only. No secrets, remote bindings, model calls or webhook notifications.
+import { spawnSync } from 'node:child_process'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+const state = mkdtempSync(join(tmpdir(), 'sunflower-d1-'))
+function wrangler(args) {
+  const result = spawnSync(process.execPath, ['node_modules/wrangler/bin/wrangler.js', ...args, '--local', '--persist-to', state], {
+    encoding: 'utf8', env: { PATH: process.env.PATH, HOME: state, CI: 'true', WRANGLER_SEND_METRICS: 'false' },
+  })
+  if (result.status !== 0) throw new Error(result.stderr || result.stdout)
+  return result.stdout
+}
+try {
+  wrangler(['d1', 'migrations', 'apply', 'awshk_frontdesk_state'])
+  const result = wrangler(['d1', 'execute', 'awshk_frontdesk_state', '--command', 'SELECT 1 AS ready', '--json'])
+  if (!JSON.parse(result).some(r => r.success && r.results.some(row => row.ready === 1))) throw new Error('D1 readiness failed')
+  console.log('Local D1 migrations and readiness query passed')
+} finally {
+  rmSync(state, { recursive: true, force: true })
+}
diff --git a/engine/src/server/readiness.ts b/engine/src/server/readiness.ts
new file mode 100644
index 0000000..63c6f9b
--- /dev/null
+++ b/engine/src/server/readiness.ts
@@ -0,0 +1,22 @@
+import type { D1Like } from './db.js'
+
+/** Read-only dependency evidence. Never seeds data, calls a model, or sends a webhook. */
+export async function readiness(db: D1Like | undefined, timeoutMs = 1500): Promise<boolean> {
+  if (!db) return false
+  let timer: ReturnType<typeof setTimeout> | undefined
+  try {
+    const result = await Promise.race([
+      db.prepare('SELECT 1 AS ready').first<{ ready: number }>(),
+      new Promise<null>((resolve) => { timer = setTimeout(() => resolve(null), timeoutMs) }),
+    ])
+    return result?.ready === 1
+  } catch {
+    return false
+  } finally {
+    if (timer) clearTimeout(timer)
+  }
+}
+
+export function buildSha(value: string | undefined): string | null {
+  return value && /^[a-f0-9]{40}$/.test(value) ? value : null
+}
diff --git a/engine/tests/readiness.test.ts b/engine/tests/readiness.test.ts
new file mode 100644
index 0000000..d93f426
--- /dev/null
+++ b/engine/tests/readiness.test.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest'
+import { readiness, buildSha } from '../src/server/readiness.js'
+import type { D1Like } from '../src/server/db.js'
+
+function database(first: () => Promise<unknown>): D1Like {
+  return { prepare: () => ({ first }) } as unknown as D1Like
+}
+
+describe('readiness evidence', () => {
+  it('requires a real successful read', async () => {
+    expect(await readiness(undefined)).toBe(false)
+    expect(await readiness(database(async () => ({ ready: 1 })))).toBe(true)
+    expect(await readiness(database(async () => null))).toBe(false)
+  })
+  it('fails closed on database errors and bounded timeout', async () => {
+    expect(await readiness(database(async () => { throw new Error('private detail') }))).toBe(false)
+    expect(await readiness(database(() => new Promise(() => {})), 5)).toBe(false)
+  })
+  it('never substitutes an unknown build SHA', () => {
+    expect(buildSha(undefined)).toBeNull()
+    expect(buildSha('main')).toBeNull()
+    expect(buildSha('a'.repeat(40))).toBe('a'.repeat(40))
+  })
+})
+
+import { app } from '../src/server/app.js'
+
+it('exposes readiness independently of liveness and model configuration', async () => {
+  const healthy = await app.request('/api/ready', {}, { DB: database(async () => ({ ready: 1 })) })
+  expect(healthy.status).toBe(200)
+  expect(await healthy.json()).toEqual({ ready: true, dependencies: { d1: 'healthy' } })
+  const failed = await app.request('/api/ready', {}, { DB: database(async () => { throw new Error('unavailable') }) })
+  expect(failed.status).toBe(503)
+  const version = await app.request('/api/version', {}, { DB: database(async () => null), BUILD_SHA: 'b'.repeat(40) })
+  expect(await version.json()).toEqual({ sha: 'b'.repeat(40) })
+  const missing = await app.request('/api/version', {}, { DB: database(async () => null) })
+  expect(await missing.json()).toEqual({ sha: null })
+  const live = await app.request('/api/health', {}, { DB: database(async () => { throw new Error('must not query') }) })
+  expect(live.status).toBe(200)
+  expect(await live.json()).toMatchObject({ modelConfigured: false })
+})
