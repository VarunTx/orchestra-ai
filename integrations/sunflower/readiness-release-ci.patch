 //     nitro (build-only using cloudflare as a default target), VITE_* env injection, @ path alias,
 //     React/TanStack dedupe, error logger plugins, and sandbox detection (port/host/strictPort).
 // You can pass additional config via defineConfig({ vite: { ... }, etc... }) if needed.
+import { execFileSync } from "node:child_process";
 import { defineConfig } from "@lovable.dev/vite-tanstack-config";
 
+const clean = execFileSync("git", ["status", "--porcelain"], { encoding: "utf8" }).trim() === "";
+const buildSha = process.env["BUILD_SHA"] ?? (clean ? execFileSync("git", ["rev-parse", "HEAD"], { encoding: "utf8" }).trim() : null);
+if (buildSha !== null && !/^[a-f0-9]{40}$/.test(buildSha)) throw new Error("BUILD_SHA must be a full commit SHA");
+
 export default defineConfig({
+  vite: {
+    plugins: [{
+      name: "release-evidence",
+      generateBundle() {
+        this.emitFile({ type: "asset", fileName: "version.json", source: JSON.stringify({ sha: buildSha }) });
+      },
+    }],
+  },
   tanstackStart: {
     // Redirect TanStack Start's bundled server entry to src/server.ts (our SSR error wrapper).
     // nitro/vite builds from this
