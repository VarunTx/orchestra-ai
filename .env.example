# Run python3 scripts/setup_env.py to generate local secrets without overwriting .env.
CONTROL_PLANE_TOKEN=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-random-password
# Single-owner dashboard password. Empty disables password login (API token only).
OWNER_PASSWORD=replace-with-a-strong-owner-password
# Encrypts connector credentials at rest. Rotate only by re-entering connector tokens.
SECRET_KEY=replace-with-a-long-random-string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Keep disabled until you authorize sending incident data to Gemini (may incur API costs).
ENABLE_GEMINI=false

# Application database (separate from Conductor's own database).
DATABASE_NAME=orchestra
DATABASE_USER=conductor
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_URL=postgresql://user:password@host:5432/orchestra

# Monitoring collector runs inside the API process.
MONITOR_ENABLED=true
MONITOR_TICK_SECONDS=2
MONITOR_RETENTION_DAYS=14
# Allow http:// and private/LAN addresses in health checks (local development only).
HTTP_CHECK_ALLOW_PRIVATE=false

# Optional existing local volume name when migrating a previous installation.
# POSTGRES_VOLUME_NAME=conductor-control-plane_postgres_data
